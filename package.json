{
  "name": "streampolis",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @streampolis/client",
    "dev:game": "npm run dev --workspace @streampolis/game-server",
    "dev:api": "npm run dev --workspace @streampolis/api",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "shot": "node tools/shoot.mjs",
    "gate:avatar": "node tools/avatar-matrix.mjs",
    "assets:fetch": "node tools/assets/fetch.mjs",
    "assets": "node tools/assets/fetch.mjs && node tools/assets/pass.mjs",
    "plaza:ab": "node tools/scene-ab.mjs --query=scene=central_plaza --out=shots/ab-praca",
    "home:ab": "node tools/scene-ab.mjs --query=apartment=me --out=shots/ab-apto",
    "gate:face": "node tools/v2-face.mjs",
    "gate:wardrobe": "node tools/v2-matrix.mjs",
    "gate:lining": "node tools/v2-lining.mjs",
    "gate:cards": "node tools/store-cards.mjs",
    "gate:walls": "node tools/room-walls-check.mjs",
    "gate:plan": "node tools/room-plan-check.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "playwright": "^1.62.1",
    "sharp": "^0.35.4"
  }
}
